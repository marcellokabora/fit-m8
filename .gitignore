key.properties

# Bubblewrap/TWA generated Android project (lives under android/) - fully regeneratable
# from android/twa-manifest.json via `bubblewrap init`/`update`, so keep it out of version
# control (android/twa-manifest.json itself IS tracked - it's the small source-of-truth
# config, not generated boilerplate).
/android/.gradle/
/android/app/
/android/gradle/
/android/gradlew
/android/gradlew.bat
/android/build.gradle
/android/settings.gradle
/android/gradle.properties
/android/local.properties
/android/manifest-checksum.txt
/android/store_icon.png
*.apk
*.apk.idsig
*.aab

