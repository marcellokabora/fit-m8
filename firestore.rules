rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: anyone auth'd can read, only the owner can write.
    // The 18+ requirement (Terms of Service) is also enforced here so it can't be bypassed by
    // calling Firestore directly (e.g. after a Google sign-in, which doesn't verify age itself).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && (!('age' in request.resource.data) || request.resource.data.age >= 18);
    }

    // Swipes: sender can read/write their own; the target can read to check for a mutual match
    match /swipes/{userId}/sent/{targetId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.uid == targetId);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Matches: readable by participants only
    match /matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.userIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.userIds;
      allow update: if request.auth != null && request.auth.uid in resource.data.userIds;
      allow delete: if request.auth != null && request.auth.uid in resource.data.userIds;
    }

    // Chats: participants only
    match /chats/{matchId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.userIds;
      }

      // Reports: create-only by the reporter; reviewed by staff via the console, not readable by clients
      match /reports/{reportId} {
        allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterId;
      }
    }
  }
