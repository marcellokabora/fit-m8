rules_version = '2';
service firebase.storage {
    match /b/{bucket}/o {

        // Avatars: anyone auth'd can view, only the owner can upload their own.
        // {photoId} is a unique filename per upload (up to 3 photos per user).
        match /avatars/{userId}/{photoId} {
            allow read: if request.auth != null;
            allow create, update: if request.auth != null
                && request.auth.uid == userId
                && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
                // Split out from the rule above: on delete, request.resource is null, so the
                // size/contentType checks can't apply here. The owner can remove their own
                // photos; admins (custom claim) can also delete another user's, for account cleanup.
                allow delete: if request.auth != null
                    && (request.auth.uid == userId || request.auth.token.admin == true);
            }
        }
    }
