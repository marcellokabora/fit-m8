# Firebase configuration — replace with your actual Firebase project values
# Get these from https://console.firebase.google.com → Project Settings → Your apps

PUBLIC_FIREBASE_API_KEY=your-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
PUBLIC_FIREBASE_APP_ID=your-app-id

# Web Push certificate ("key pair") from Firebase Console → Project Settings →
# Cloud Messaging → Web configuration. Required for push notifications.
PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key
